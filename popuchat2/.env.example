# popuchat2/.env.example
# Plantilla de configuración de credenciales Dual IA para PopuChat 2
# Duplica este archivo como .env y coloca tus API Keys (Groq Qwen + Google Gemini)

GROQ_API_KEY=PEGA_AQUI_TU_API_KEY_DE_GROQ
GEMINI_API_KEY=PEGA_AQUI_TU_API_KEY_DE_GOOGLE_AI_STUDIO
GEMINI_MODEL=gemini-flash-latest
